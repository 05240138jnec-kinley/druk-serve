# Copy this file to ".env" and change the values.  NEVER upload ".env" to GitHub.

PORT=5000
NODE_ENV=development

# MySQL (or XAMPP MariaDB). With the Docker file use: DB_PASSWORD=drukserve_root
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=druk_serve

# Login tokens. Use a long random text (32+ characters) and keep it secret.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start while this still says "change-this..."
JWT_SECRET=change-this-to-a-long-random-text-of-32-or-more-characters
JWT_EXPIRES_IN=1d

# The address your frontend runs on (VS Code Live Server uses port 5500).
# Several addresses can be separated by commas.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Most login/register attempts per IP address every 15 minutes (use 10 to 20 when you go live)
AUTH_RATE_LIMIT=100

# "sandbox" = pretend payments that always succeed (for development and your demo).
# "live"    = real BOB mPay / BNB ePay. Needs the bank's merchant details, see src/payments/gateway.js
PAYMENT_MODE=sandbox
