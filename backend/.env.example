# Copy this file to a new file named ".env" and (if needed) change the values.
# XAMPP's default MySQL login is user "root" with an EMPTY password.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=druk_serve

# Login tokens are signed with this secret. Replace it with your own long random text.
# To make one, run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=7d

# How many login/register attempts one computer may make in 15 minutes (optional)
# AUTH_RATE_LIMIT=30
