# Copy this file to a new file named ".env" and (if needed) change the values.
# XAMPP's default MySQL login is user "root" with an EMPTY password.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=druk_serve

# Used from Backend Step 2 (login tokens). Use a long random text of your own.
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=7d
